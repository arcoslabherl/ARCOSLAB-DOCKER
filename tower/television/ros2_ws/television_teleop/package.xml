<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>television_teleop</name>
  <version>0.1.0</version>
  <description>Stereo video from a ZED camera to a WebXR headset (Open-TeleVision), with the head pose as a ROS topic.</description>
  <maintainer email="aguterralgo@gmail.com">ARCoS-Lab</maintainer>
  <license>GPLv3</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- vuer (pip, pinned), the ZED SDK and pyzed are installed by the Dockerfile -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
