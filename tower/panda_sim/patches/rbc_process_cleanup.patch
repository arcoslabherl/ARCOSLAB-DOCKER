+def stop_children(rbc, timeout=2.0):
+    # Reachers and extenders run in child processes. Stop them here:
+    # otherwise multiprocessing waits for them at exit and they are
+    # left running (orphaned) when RBC is finally killed.
+    # A repeated Ctrl+C (terminal + ros2 launch) must not abort cleanup.
+    signal.signal(signal.SIGINT, signal.SIG_IGN)
+    processes = [entry["process"] for entry in
+                 list(rbc._reachers.values()) + list(rbc._extenders.values())]
+    for process in processes:
+        if process.is_alive():
+            process.terminate()
+    for process in processes:
+        process.join(timeout)
+        if process.is_alive():
+            process.kill()
+
+
 def main(args=None):
