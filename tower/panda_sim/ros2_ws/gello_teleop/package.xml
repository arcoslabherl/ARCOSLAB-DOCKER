<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gello_teleop</name>
  <version>0.1.0</version>
  <description>GELLO teleoperation for the ARCoS-Lab Franka Panda (simulated and real).</description>
  <maintainer email="aguterralgo@gmail.com">ARCoS-Lab</maintainer>
  <license>GPLv3</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>impedance_control_msgs</exec_depend>
  <exec_depend>panda_topics_msgs_srvs</exec_depend>
  <!-- dynamixel-sdk (pip, pinned) and python3-serial are installed by the Dockerfile -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
